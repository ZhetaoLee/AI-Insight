{
  "name": "ai-productivity-insights-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vite build --config vite.config.ts --ssr tests/frontend.test.mjs --outDir .test-dist --emptyOutDir && node --test .test-dist/frontend.test.js",
    "test:e2e": "sh -c 'docker compose -f ../docker-compose.yml down -v && playwright test; status=$?; docker compose -f ../docker-compose.yml down -v; exit $status'",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
